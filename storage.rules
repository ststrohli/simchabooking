rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (firestore.exists(/databases/(default)/documents/user_roles/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/user_roles/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isVendor(vendorId) {
      return isAuthenticated() && (
        request.auth.uid == vendorId ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.vendorId == vendorId)
      );
    }

    // Public read for all uploaded assets so the frontend can display them
    match /{allPaths=**} {
      allow read: if true;
    }

    match /user_uploads/{userId}/{allPaths=**} {
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /vendors/{vendorId}/{allPaths=**} {
      // Vendor can write their own folder
      allow write: if isVendor(vendorId) || isAdmin();
    }

    match /chats/{allPaths=**} {
      // Anyone authenticated can upload to chats (messages, attachments)
      allow write: if isAuthenticated();
    }

    match /taxonomy/{allPaths=**} {
      allow write: if isAdmin();
    }
    
    match /categories/{allPaths=**} {
      allow write: if isAdmin();
    }
    
    match /hero/{allPaths=**} {
      allow write: if isAdmin();
    }
  }
}

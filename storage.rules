rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        firestore.get(/databases/ai-studio-b85c10e8-0729-4d1f-841b-60b5c119be28/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        firestore.get(/databases/ai-studio-b85c10e8-0729-4d1f-841b-60b5c119be28/documents/user_roles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Public read for all uploaded assets so the frontend can display them
    match /{allPaths=**} {
      allow read: if true;
    }

    match /user_uploads/{userId}/{allPaths=**} {
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /vendors/{vendorId}/{allPaths=**} {
      // Vendor can write their own folder
      allow write: if isAuthenticated() && (request.auth.uid == vendorId || isAdmin());
    }

    match /chats/{allPaths=**} {
      // Anyone authenticated can upload to chats (messages, attachments)
      allow write: if isAuthenticated();
    }

    match /taxonomy/{allPaths=**} {
      allow write: if isAdmin();
    }
    
    match /categories/{allPaths=**} {
      allow write: if isAdmin();
    }
    
    match /hero/{allPaths=**} {
      allow write: if isAdmin();
    }
  }
}

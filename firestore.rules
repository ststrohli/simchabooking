rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Default: Deny all unhandled access by default
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. Global Security Helpers
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && request.auth.token != null && (
        request.auth.token.get('email', '').toLowerCase() in ['bookingsimcha@gmail.com', 'shimpose@gmail.com', 'ststrohli@gmail.com'] ||
        (request.auth.token.email != null && request.auth.token.email.toLowerCase() in ['bookingsimcha@gmail.com', 'shimpose@gmail.com', 'ststrohli@gmail.com'])
      );
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('role', '')
        : (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', '')
          : (request.auth.token != null ? request.auth.token.get('role', '') : ''));
    }

    function isAdmin() {
      return isHardcodedAdmin() || getUserRole() == 'admin';
    }

    function hasRole(roleName) {
      return isAuthenticated() && (
        getUserRole() == roleName ||
        (roleName == 'admin' && isAdmin())
      );
    }

    function isParticipantOfId(conversationId) {
      return isAuthenticated() && (
        conversationId == request.auth.uid ||
        conversationId.matches('^' + request.auth.uid + '_.*') ||
        conversationId.matches('.*_' + request.auth.uid + '$') ||
        (isAdmin() && (conversationId == 'admin' || conversationId.matches('^admin_.*') || conversationId.matches('.*_admin$')))
      );
    }

    function isVendor(vendorId) {
      return isAuthenticated() && (
        isOwner(vendorId) || 
        hasRole('vendor') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('vendorId', '') == vendorId)
      );
    }

    // ===============================================================
    // 2. Strict User Roles Lockdown (/user_roles/{userId})
    // ===============================================================
    
    match /roles/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isHardcodedAdmin());
      allow write: if isHardcodedAdmin();
    }

    match /user_roles/{userId} {
      // Users can read their own role or admins can read any role
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // Auto-provisioning by public user: strictly 'client' role allowed (or 'admin' if hardcoded admin)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (
          (request.resource.data.get('role', '') == 'admin' && isHardcodedAdmin()) ||
          (request.resource.data.get('role', '') in ['client', 'vendor'] && request.resource.data.get('role', '') != 'admin')
        ))
      );

      // Strictly blocks non-admin users from updating or deleting roles. Only admins can update or delete user roles.
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // ===============================================================
    // 3. Collection Access Enforcement
    // ===============================================================

    // Vendors: Publicly readable; Writes restricted to vendor owners or admins
    match /vendors/{vendorId} {
      allow read: if true;
      allow create, update: if isAdmin() || isVendor(vendorId);
      allow delete: if isAdmin();
    }

    // Categories & Taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Posts & Articles
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Metadata & Testing
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Users: Authenticated profile management
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(uid) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Bookings: Clients create bookings bound to their ID; Clients, Vendors, and Admins can manage involved bookings
    match /bookings/{bookingId} {
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('clientId', '') == request.auth.uid
      );
      
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('clientId', '') == request.auth.uid ||
        isVendor(resource.data.get('vendorId', '')) || 
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isVendor(resource.data.get('vendorId', '')) ||
        ((resource.data.get('userId', '') == request.auth.uid || resource.data.get('clientId', '') == request.auth.uid) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'amount', 'priceStart', 'paymentStatus']))
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('clientId', '') == request.auth.uid
      ));
    }

    // Messaging & Live Chats: Authenticated participants or admins
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        isAdmin() ||
        isParticipantOfId(conversationId) ||
        (resource == null && request.resource != null && request.auth.uid in request.resource.data.get('participant_ids', [])) ||
        (resource != null && request.auth.uid in resource.data.get('participant_ids', []))
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          isAdmin() ||
          isParticipantOfId(conversationId) ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participant_ids', []))
        );
      }
      
      match /members/{userId} {
        allow read, write: if isAuthenticated() && (
          isAdmin() ||
          isParticipantOfId(conversationId) ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participant_ids', []))
        );
      }
    }

    // System Logging & Analytics
    match /analytics_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /webhook_debug/{docId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}

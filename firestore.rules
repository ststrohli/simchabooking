rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Default: Deny all unhandled access by default
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. Global Security Helpers
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email_verified == true && (
          request.auth.token.email.lower() == 'bookingsimcha@gmail.com' ||
          request.auth.token.email.lower() == 'adminbookingsimcha@gmail.com' ||
          request.auth.token.email.lower() == 'shimpose@gmail.com' ||
          request.auth.token.email.lower() == 'ststrohli@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        )) ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('isAdmin', false) == true
        ))
      );
    }

    function hasRole(roleName) {
      return isAuthenticated() && (
        (roleName == 'admin' && isAdmin()) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == roleName ||
          (roleName == 'vendor' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isVendor', false) == true)
        )) ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('role', '') == roleName ||
          (roleName == 'vendor' && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('isVendor', false) == true)
        )) ||
        (request.auth.token != null && request.auth.token.get('role', '') == roleName)
      );
    }

    function isParticipantOfId(conversationId) {
      return isAuthenticated() && (
        request.auth.uid in conversationId.split('_') ||
        isAdmin()
      );
    }

    function isVendor(vendorId) {
      return isAuthenticated() && (
        isOwner(vendorId) || 
        hasRole('vendor') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('vendorId', '') == vendorId) ||
        (exists(/databases/$(database)/documents/vendors/$(vendorId)) && request.auth.token.email != null && (
          get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('contactEmail', '').lower() == request.auth.token.email.lower() ||
          get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('username', '').lower() == request.auth.token.email.lower()
        ))
      );
    }

    // ===============================================================
    // 2. Strict User Roles Lockdown (/user_roles/{userId})
    // ===============================================================
    
    match /roles/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow write: if isAdmin();
    }

    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        userId.startsWith('invite_')
      );

      allow create: if isAuthenticated() && (
        isAdmin() ||
        userId.startsWith('invite_') ||
        (isOwner(userId) && request.resource.data.get('role', 'client') in ['client', 'vendor'])
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.get('role', '') == resource.data.get('role', ''))
      );

      allow delete: if isAuthenticated() && (
        isAdmin() || 
        userId.startsWith('invite_')
      );
    }

    // ===============================================================
    // 3. Collection Access Enforcement
    // ===============================================================

    // Vendors: Publicly readable; Writes restricted to vendor owners or admins
    match /vendors/{vendorId} {
      allow read: if true;
      allow create, update: if isAdmin() || isVendor(vendorId) || (
        isAuthenticated() && request.auth.token.email != null && (
          (resource != null && (
            resource.data.get('contactEmail', '').lower() == request.auth.token.email.lower() ||
            resource.data.get('username', '').lower() == request.auth.token.email.lower()
          )) ||
          (request.resource != null && (
            request.resource.data.get('contactEmail', '').lower() == request.auth.token.email.lower() ||
            request.resource.data.get('username', '').lower() == request.auth.token.email.lower()
          ))
        )
      );
      allow delete: if isAdmin();
    }

    // Categories & Taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Posts & Articles
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('vendor');
    }

    // System Metadata & Testing
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Authenticated profile management
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isOwner(uid) && !request.resource.data.keys().hasAny(['isAdmin']));
      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']));
      allow delete: if isAdmin() || isOwner(uid);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Bookings: Clients create bookings bound to their ID; Clients, Vendors, and Admins can manage involved bookings
    match /bookings/{bookingId} {
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('clientId', '') == request.auth.uid ||
        isAdmin()
      );
      
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('clientId', '') == request.auth.uid ||
        isVendor(resource.data.get('vendorId', '')) || 
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isVendor(resource.data.get('vendorId', '')) ||
        ((resource.data.get('userId', '') == request.auth.uid || resource.data.get('clientId', '') == request.auth.uid) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'amount', 'priceStart', 'paymentStatus']))
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('clientId', '') == request.auth.uid
      ));
    }

    // Messaging & Live Chats: Authenticated participants, vendors, or admins
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isAdmin() ||
        isParticipantOfId(conversationId) ||
        request.auth.uid in resource.data.get('participant_ids', []) ||
        resource.data.get('client_id', '') == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.get('client_email', '') == request.auth.token.email ||
          resource.data.get('client_email', '').lower() == request.auth.token.email.lower() ||
          resource.data.get('client_id', '').lower() == request.auth.token.email.lower() ||
          request.auth.token.email.lower() in resource.data.get('participant_ids', [])
        )) ||
        (resource.data.get('vendor_id', '') != '' && isVendor(resource.data.get('vendor_id', ''))) ||
        hasRole('vendor')
      );
      allow write: if isAuthenticated() && (
        isAdmin() ||
        isParticipantOfId(conversationId) ||
        (request.resource != null && (
          request.auth.uid in request.resource.data.get('participant_ids', []) ||
          request.resource.data.get('client_id', '') == request.auth.uid
        )) ||
        (resource != null && (
          request.auth.uid in resource.data.get('participant_ids', []) ||
          resource.data.get('client_id', '') == request.auth.uid ||
          (resource.data.get('vendor_id', '') != '' && isVendor(resource.data.get('vendor_id', '')))
        )) ||
        hasRole('vendor')
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          isAdmin() ||
          isParticipantOfId(conversationId) ||
          hasRole('vendor') ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participant_ids', []) ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('client_id', '') == request.auth.uid ||
            (request.auth.token.email != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('client_email', '').lower() == request.auth.token.email.lower())
          ))
        );
      }
      
      match /members/{userId} {
        allow read, write: if isAuthenticated() && (
          isAdmin() ||
          isParticipantOfId(conversationId) ||
          hasRole('vendor') ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participant_ids', []) ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('client_id', '') == request.auth.uid
          ))
        );
      }
    }

    // System Logging, Analytics & Bot Security Flags
    match /analytics_logs/{logId} {
      allow create: if request.resource.data.keys().size() <= 15;
      allow read, update, delete: if isAdmin();
    }

    match /security_flags/{flagId} {
      allow create: if request.resource.data.keys().size() <= 15;
      allow read, update, delete: if isAdmin();
    }
    
    match /webhook_debug/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
